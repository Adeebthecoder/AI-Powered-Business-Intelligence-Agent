# =============================================================================
#  AI-Powered Business Intelligence Agent : settings file (example)
# =============================================================================
#  Do NOT edit this file. Make your own copy called ".env" by running:
#
#      python scripts/make_env.py        (run it from the backend folder)
#
#  That script copies this file to ".env" and fills in every value marked
#  GENERATE_ME with a strong random value. The ".env" file stays on your
#  laptop only. Never share it and never upload it to GitHub.
# =============================================================================

# ----- 1. LLM (OpenRouter) ---------------------------------------------------
# LLM_MODE=mock : no internet and no key needed. Answers a fixed list of demo
#                 questions. Use this to test the app and as a demo safety net.
# LLM_MODE=live : calls OpenRouter. Needs OPENROUTER_API_KEY below.
LLM_MODE=mock

# Paste your OpenRouter key here (it starts with "sk-or-"). Leave empty in mock mode.
OPENROUTER_API_KEY=

OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# Optional. A second model that is tried when the main model fails.
# Leave empty to switch this off.
LLM_FALLBACK_MODEL=

# Free tier limits. The app counts its own calls and stops politely before
# OpenRouter blocks us.
LLM_MAX_CALLS_PER_MINUTE=20
LLM_MAX_CALLS_PER_DAY=50

# ----- 2. PostgreSQL ---------------------------------------------------------
# Use 5432 if PostgreSQL is installed on your laptop.
# Use 5433 if you start PostgreSQL with Docker but ALSO have PostgreSQL installed
# (two servers cannot share port 5432).
DB_HOST=localhost
DB_PORT=5432
DB_NAME=bi_agent

# The app user owns the tables and can read and write.
DB_APP_USER=bi_app
DB_APP_PASSWORD=GENERATE_ME

# The read-only user can only SELECT from uploaded dataset tables.
# Every AI-written query runs as this user.
DB_READONLY_USER=bi_readonly
DB_READONLY_PASSWORD=GENERATE_ME

# The PostgreSQL administrator. Only used once, by setup_database.py.
# Docker: the generated value below becomes the administrator password.
# Installed PostgreSQL: leave as generated, the setup script will ask you to
# type the password you chose when you installed PostgreSQL.
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=GENERATE_ME

# ----- 3. Login security -----------------------------------------------------
JWT_SECRET=GENERATE_ME
JWT_EXPIRE_MINUTES=480

# ----- 4. Demo accounts ------------------------------------------------------
# Created automatically the first time the backend starts.
# These are demo-only logins for the project presentation. Change the
# passwords here (before the first start) if you want different ones.
DEMO_USER_EMAIL=demo@biagent.local
DEMO_USER_PASSWORD=Demo@12345
ADMIN_EMAIL=admin@biagent.local
ADMIN_PASSWORD=Admin@12345

# ----- 5. Query safety -------------------------------------------------------
# Largest number of rows an AI-written query may return.
SQL_MAX_ROWS=1000
# A query is cancelled if it runs longer than this many seconds.
SQL_TIMEOUT_SECONDS=10

# ----- 6. Uploads ------------------------------------------------------------
MAX_UPLOAD_MB=20

# Address of the frontend, allowed to call the backend.
FRONTEND_ORIGIN=http://localhost:5173
